{
    "name": "nemorize/hanji",
    "description": "A lightweight static site generator for PHP.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "illuminate/container": "^13.0",
        "illuminate/events": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0",
        "league/commonmark": "^2.8",
        "nikic/php-parser": "^5.7",
        "symfony/console": "^7.4",
        "symfony/filesystem": "^7.4",
        "symfony/finder": "^7.4",
        "symfony/process": "^8.0",
        "symfony/yaml": "^7.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.0",
        "scssphp/scssphp": "^2.1"
    },
    "suggest": {
        "scssphp/scssphp": "^2.1 enables the optional PHP SCSS build plugin."
    },
    "autoload": {
        "classmap": ["src/Hanji.php"],
        "psr-4": {
            "Hanji\\": "src/"
        }
    },
    "bin": ["bin/hanji"],
    "autoload-dev": {
        "psr-4": {
            "Hanji\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": false,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "validate:composer": "@composer validate --strict",
        "analyse": "phpstan analyse --no-progress",
        "format": "php-cs-fixer fix",
        "format:check": "php-cs-fixer fix --dry-run --diff",
        "test": "phpunit",
        "check": [
            "@validate:composer",
            "@format:check",
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "validate:composer": "Validate the Composer package and lock file.",
        "analyse": "Run PHPStan static analysis.",
        "format": "Apply the PHP coding style.",
        "format:check": "Check the PHP coding style without changing files.",
        "test": "Run the PHPUnit test suite.",
        "check": "Run all development checks."
    }
}
